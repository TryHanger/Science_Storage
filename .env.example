# Database connection URL (binds to 127.0.0.1:5434 in compose.yaml)
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5434/research_engine

# Optional OpenAlex API key (improves rate limits, not required for basic access)
OPENALEX_API_KEY=

# OpenAlex mailto for polite pool (e.g. researcher@example.com)
OPENALEX_MAILTO=researcher@example.com
